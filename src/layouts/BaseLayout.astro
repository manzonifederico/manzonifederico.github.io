---
// Shared page shell: <head> with SEO and social preview tags, fonts, global CSS.
// Fonts are self-hosted from npm packages (@fontsource), no Google Fonts requests. Only the Latin subset is
// loaded (latin-*.css): it covers English and Italian, and keeps the CSS and the font files small.
import OverscrollNote from '../components/OverscrollNote.astro';
import '@fontsource/poppins/latin-300.css';
import '@fontsource/poppins/latin-400.css';
import '@fontsource/poppins/latin-400-italic.css';
import '@fontsource/poppins/latin-500.css';
import '@fontsource/poppins/latin-700.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/commissioner/latin-300.css';
// Project wordmark fonts
import '@fontsource/ibm-plex-serif/latin-500-italic.css';
import '@fontsource/ibm-plex-serif/latin-500.css';
import '@fontsource/freckle-face/latin-400.css';
import '@fontsource/rubik/latin-400.css';
import '@fontsource/rubik/latin-500.css';
import '@fontsource/rubik/latin-700.css';
import '@fontsource/josefin-sans/latin-500-italic.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/roboto/latin-400.css';
import '@fontsource/roboto/latin-500.css';
import '@fontsource/roboto/latin-700.css';
import '../styles/global.css';
import '../styles/themes.css';
import { site, siteText } from '../data/site';
import { t, localePath, type Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
  image?: string;
  /** text description of the social preview image */
  imageAlt?: string;
  /** pixel size of the social preview image (default: the 1200×630 og-image.png) */
  imageWidth?: number;
  imageHeight?: number;
  /** 'article' on case studies, 'website' elsewhere (social previews) */
  type?: 'website' | 'article';
  /** keep the page out of search results (e.g. 404) */
  noindex?: boolean;
  /** CSS class on <body>, used for per-project themes */
  bodyClass?: string;
  /** false on pages that only exist in one language (e.g. 404) */
  alternates?: boolean;
}

const { lang = 'en', bodyClass, alternates = true, type = 'website', noindex = false } = Astro.props;
const title = Astro.props.title ?? siteText[lang].title;
const description = Astro.props.description ?? siteText[lang].description;
const image = Astro.props.image ?? site.ogImage;
const imageAlt = Astro.props.imageAlt ?? siteText[lang].title;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const altUrl = (l: Lang) => new URL(localePath(l, Astro.url.pathname), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    {
      /* Security (GitHub Pages can't send HTTP headers, so the policy is a meta tag; published build only,
         the dev server needs its live-reload connection): the page may only load scripts, styles, fonts,
         images, audio and video from this site; no plug-ins, no frames, no form posts elsewhere. */
      import.meta.env.PROD && (
        <meta
          http-equiv="Content-Security-Policy"
          content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; media-src 'self'; connect-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        />
      )
    }
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    <link rel="canonical" href={canonical} />
    {
      alternates && (
        <>
          <link rel="alternate" hreflang="en" href={altUrl('en')} />
          <link rel="alternate" hreflang="it" href={altUrl('it')} />
          <link rel="alternate" hreflang="x-default" href={altUrl('en')} />
        </>
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#145ee1" />
    <meta name="color-scheme" content="light dark" />
    <!-- colour theme picked with the theme button (light / dark); none = follow the device. Runs before the page
         paints, so there is no flash of the wrong colours -->
    <script is:inline>
      try {
        var th = localStorage.getItem('theme');
        if (th === 'light' || th === 'dark') document.documentElement.dataset.theme = th;
      } catch (e) {}
    </script>
    <!-- for testing: add ?replay to any address and the one-time things (game snackbar, recruiter intro, shake and
         lighter-mode notes) show again as on a first visit -->
    <script is:inline>
      try {
        if (/[?&]replay(=|&|$)/.test(location.search))
          ['arrows-hint-seen', 'arrows-hint-seen-2', 'recruiter-intro-seen', 'shake-hint-seen', 'lite-note'].forEach(function (k) {
            localStorage.removeItem(k);
          });
      } catch (e) {}
    </script>
    <!-- lighter mode before the first paint (src/scripts/perf.ts): the visitor's own choice wins; otherwise a weak
         device (4 cores or fewer, 2 GB of memory or less, "data saver", or a slow first visit) starts light -->
    <script is:inline>
      try {
        var ef = localStorage.getItem('effects');
        var n = navigator;
        var weak =
          (n.hardwareConcurrency || 8) <= 4 ||
          (n.deviceMemory || 8) <= 2 ||
          (n.connection && n.connection.saveData) ||
          localStorage.getItem('perf-lite') === '1';
        if (ef === 'off' || (ef !== 'on' && weak)) document.documentElement.classList.add('lite');
      } catch (e) {}
    </script>
    <meta name="author" content={site.name} />

    <!-- Social previews (LinkedIn, WhatsApp, Slack, X…) -->
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'it' ? 'it_IT' : 'en_GB'} />
    {alternates && <meta property="og:locale:alternate" content={lang === 'it' ? 'en_GB' : 'it_IT'} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    {
      /* size only when it is known for sure: the default image, or a size passed in */
      (!Astro.props.image || Astro.props.imageWidth) && (
        <>
          <meta property="og:image:width" content={String(Astro.props.imageWidth ?? 1200)} />
          <meta property="og:image:height" content={String(Astro.props.imageHeight ?? 630)} />
        </>
      )
    }
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <!-- summary of the site and AI use policy for AI assistants: /llms.txt (see src/pages/llms.txt.ts) -->

    <!-- Restore unbiased mode before the page paints, so names never flash -->
    <script is:inline>
      try {
        localStorage.removeItem('unbiased-mode');
        if (sessionStorage.getItem('unbiased-mode') === '1') document.documentElement.dataset.unbiased = 'true';
        var pointerPref = localStorage.getItem('pointer-classic');
        var highContrast = matchMedia('(forced-colors: active), (prefers-contrast: more)').matches;
        if (pointerPref === '1' || (pointerPref === null && highContrast))
          document.documentElement.classList.add('classic-pointer');
      } catch (e) {}
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">{t(lang).skip}</a>
    <slot />
    <OverscrollNote lang={lang} />
    <script>
      import '../scripts/unbiased';
      import '../scripts/perf';

      // loaded only when they can be used, so phones and keyboard users don't download or run them:
      // the pointer extras once there is a mouse (now, or at its first move on a touch device)…
      const fine = matchMedia('(any-hover: hover) and (any-pointer: fine)');
      let cursor: Promise<unknown> | null = null;
      const loadCursor = () => (cursor ??= import('../scripts/view-cursor'));
      if (fine.matches) loadCursor();
      else {
        fine.addEventListener?.('change', () => fine.matches && loadCursor());
        const onMove = (e: PointerEvent) => {
          if (e.pointerType !== 'mouse') return;
          document.removeEventListener('pointermove', onMove);
          loadCursor();
        };
        document.addEventListener('pointermove', onMove, { passive: true });
      }
      // …and the controller support once a controller is connected (or already is)
      const loadPad = () => import('../scripts/gamepad');
      if (Array.from(navigator.getGamepads?.() ?? []).some((p) => p && p.connected)) loadPad();
      else addEventListener('gamepadconnected', loadPad, { once: true });
    </script>
  </body>
</html>
