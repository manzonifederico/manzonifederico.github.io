---
// "Hey!" intro with the blurred blue blob and the language switch (Figma: Intro).
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<header class="hero" id="top">
  <div class="blob" aria-hidden="true"><span class="lobe"></span></div>
  <div class="hero-inner container">
    <h1 class="hero-title">{s.heroTitle}</h1>
    <p class="hero-sub">
      {s.heroSub1}<br />
      {s.heroSub2}
    </p>
  </div>
  <div class="hero-lang">
    <ThemeSwitch lang={lang} />
    <LangSwitch lang={lang} />
  </div>
</header>

<script>
  // EN / IT and the theme button sit in the top-right corner, where the moving blob sometimes reaches. A few times a
  // second (only while the blob moves) this works out how much of the blob's colour is behind them (from the blob's real position: its layers are
  // blurred ellipses) and picks the ink that reads better there: the brand blue on the page, the light ink on the blob.
  // It only runs while the top of the page is on screen.
  const hero = document.querySelector<HTMLElement>('.hero');
  const blob = hero?.querySelector<HTMLElement>('.blob');
  const lobe = blob?.querySelector<HTMLElement>('.lobe');
  const corner = hero?.querySelector<HTMLElement>('.hero-lang');

  if (hero && blob && lobe && corner) {
    const root = document.documentElement;
    const phi = (x: number) => 1 / (1 + Math.exp(-1.702 * x)); // close to the normal curve of a Gaussian blur
    const rgb = (v: string) => {
      const c = document.createElement('canvas').getContext('2d')!;
      c.fillStyle = v.trim() || '#000';
      const h = c.fillStyle as string; // always "#rrggbb" for opaque colours
      return [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
    };
    const lum = (c: number[]) => {
      const l = c.map((v) => ((v /= 255) <= 0.04045 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4));
      return 0.2126 * l[0] + 0.7152 * l[1] + 0.0722 * l[2];
    };
    const contrast = (a: number[], b: number[]) => {
      const [x, y] = [lum(a), lum(b)].sort((m, n) => n - m);
      return (x + 0.05) / (y + 0.05);
    };
    const matrix = (cs: CSSStyleDeclaration) => new DOMMatrix(cs.transform === 'none' ? undefined : cs.transform);

    // one layer: its box inside the blob, its own transform (about its centre) and its blur
    const layer = (cs: CSSStyleDeclaration, x: number, y: number, w: number, h: number) => ({
      box: [x, y, w, h],
      m: new DOMMatrix().translate(x + w / 2, y + h / 2).multiply(matrix(cs)).translate(-w / 2, -h / 2),
      blur: parseFloat(cs.filter.replace(/[^\d.]/g, '')) || 1,
    });

    const coverage = (points: DOMPoint[]) => {
      const bs = getComputedStyle(blob);
      const W = blob.offsetWidth;
      const H = blob.offsetHeight;
      const hr = hero.getBoundingClientRect();
      // "none", "0px" or "12px 4px": a missing value is 0
      const [tx = 0, ty = 0] = (bs.translate === 'none' ? '' : bs.translate).split(' ').map((v) => parseFloat(v) || 0);
      // the blob: tilt ("translate"), then its breathing transform, both about its centre
      const mb = new DOMMatrix()
        .translate(hr.left + blob.offsetLeft + W / 2 + tx, hr.top + blob.offsetTop + H / 2 + ty)
        .multiply(matrix(bs))
        .translate(-W / 2, -H / 2);
      const before = getComputedStyle(blob, '::before');
      const after = getComputedStyle(blob, '::after');
      const layers = [
        layer(before, 0, 0, W, H),
        layer(after, parseFloat(after.left), parseFloat(after.top), parseFloat(after.width), parseFloat(after.height)),
        layer(getComputedStyle(lobe), lobe.offsetLeft, lobe.offsetTop, lobe.offsetWidth, lobe.offsetHeight),
      ];
      let sum = 0;
      for (const p of points) {
        let clear = 1;
        for (const l of layers) {
          const q = mb.multiply(l.m).inverse().transformPoint(p);
          const [, , w, h] = l.box;
          const dx = q.x - w / 2;
          const dy = q.y - h / 2;
          const r = Math.hypot(dx / (w / 2), dy / (h / 2));
          const inside = r === 0 ? Math.min(w, h) / 2 : Math.hypot(dx, dy) * (1 / r - 1); // px inside the edge
          clear *= 1 - phi(inside / l.blur);
        }
        sum += 1 - clear;
      }
      return sum / points.length;
    };

    let timer = 0;
    const check = () => {
      const r = corner.getBoundingClientRect();
      if (!r.width) return;
      const points = [0.15, 0.5, 0.85].flatMap((fx) =>
        [0.3, 0.7].map((fy) => new DOMPoint(r.left + r.width * fx, r.top + r.height * fy)),
      );
      const a = coverage(points);
      const css = getComputedStyle(root);
      const page = rgb(css.getPropertyValue('--color-bg'));
      const block = rgb(css.getPropertyValue('--color-block'));
      const behind = page.map((v, i) => v + (block[i] - v) * a);
      const onPage = contrast(rgb(css.getPropertyValue('--color-brand-ink')), behind);
      const onBlob = contrast(rgb(css.getPropertyValue('--color-text-inverse')), behind);
      const now = corner.dataset.ink;
      // a small margin keeps it from flickering while the blob's edge hovers right on the switch
      if (onBlob > onPage * (now === 'dark' ? 1.15 : 1)) corner.dataset.ink = 'light';
      else if (onPage > onBlob * (now === 'light' ? 1.15 : 1)) corner.dataset.ink = 'dark';
    };
    // repeated only while the blob moves: in lighter mode or with reduced motion it stands still, so one check
    // (and one after a resize or a theme change) is enough
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    let onScreen = false;
    const update = () => {
      window.clearInterval(timer);
      timer = 0;
      if (!onScreen || document.hidden) return;
      check();
      if (!root.classList.contains('lite') && !reduce.matches) timer = window.setInterval(check, 250);
    };
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      update();
    }).observe(corner);
    document.addEventListener('visibilitychange', update);
    reduce.addEventListener?.('change', update);
    addEventListener('resize', check, { passive: true });
    new MutationObserver(update).observe(root, { attributes: true, attributeFilter: ['data-theme', 'class'] });
  }

  export {}; // a module, so its names stay private
</script>

<style>
  .hero {
    position: relative;
    /* the intro fills the first screen, so only the very top of the big name below peeks out at the bottom edge,
       like a hint to scroll (and it can't be read before recruiter mode is chosen). The name starts the About
       section's top padding plus ~0.14em of line spacing below the hero, and its capitals start ~0.35em into its
       line box: showing ~0.5em of it shows only the top fifth of the capitals. Never shorter than the Figma height on wide, short windows. */
    --name-peek: calc(clamp(16px, 2vw, 28px) + 0.79 * var(--fs-title));
    min-height: max(clamp(420px, 40vw, 597px), calc(100vh - var(--name-peek)));
    min-height: max(clamp(420px, 40vw, 597px), calc(100svh - var(--name-peek)));
    /* let the blurred blob fade out below the hero, but never cause sideways scrolling */
    overflow-x: clip;
    overflow-y: visible;
    color: var(--color-text-inverse);
  }

  /* Blurred ellipse: 1195×709 at (-223, -184) in the 1440 frame */
  .blob {
    position: absolute;
    /* follow the centred content column on screens wider than 1440px */
    left: calc(max(0px, (100% - var(--content-max)) / 2) - min(15.5vw, 223px));
    top: -184px;
    /* 1195px wide in Figma; never smaller than ~980px so the white text always sits on blue */
    width: max(83%, 980px);
    max-width: 1195px;
    aspect-ratio: 1195 / 709;
    translate: var(--tilt-x, 0) var(--tilt-y, 0); /* a tilted phone moves the glow (ArrowBugs.astro) */
    transition: translate 400ms ease-out;
    will-change: transform;
    /* breathes: swells and settles in place, slow enough not to distract */
    animation: hero-breathe 9s ease-in-out infinite alternate;
  }

  @keyframes hero-breathe {
    0% {
      transform: translate3d(-2%, 8px, 0) rotate(-2deg) scale(1);
    }
    45% {
      transform: translate3d(1.5%, -14px, 0) rotate(1.5deg) scale(1.08);
    }
    100% {
      transform: translate3d(3%, 4px, 0) rotate(2.5deg) scale(1.03);
    }
  }


  /* the waves: a blurred core in the blob's own shape, which never shrinks (so the white text always stays on solid
     blue), and two blurred lobes on its right and bottom edges that swell out into the white space and pull back,
     out of step. Together they make the edge bulge and ripple deeply. Only transforms move (the graphics card does
     it), so each blur is drawn once and the page stays smooth */
  .blob::before,
  .blob::after,
  .lobe {
    content: '';
    position: absolute;
    border-radius: 50%;
    background: var(--color-block);
    filter: blur(80px);
    will-change: transform;
  }

  .blob::before {
    inset: 0;
    animation: core 8s ease-in-out infinite alternate;
  }

  /* right-hand lobe (lopsided, so as it turns the bulge changes shape) */
  .blob::after {
    border-radius: 62% 38% 55% 45% / 48% 58% 42% 52%;
    left: 52%;
    top: 22%;
    width: 52%;
    height: 62%;
    animation: lobe-a 6s ease-in-out infinite alternate;
  }

  /* bottom lobe */
  .lobe {
    border-radius: 40% 60% 48% 52% / 58% 44% 56% 42%;
    left: 14%;
    top: 44%;
    width: 58%;
    height: 56%;
    animation: lobe-b 7.5s ease-in-out infinite alternate;
  }

  @keyframes core {
    from {
      transform: rotate(-2deg) scale(1.02);
    }
    to {
      transform: rotate(2deg) scale(1.05, 1.02);
    }
  }

  @keyframes lobe-a {
    from {
      transform: translate(-16%, -8%) rotate(-18deg) scale(0.7, 0.75);
    }
    to {
      transform: translate(26%, 16%) rotate(16deg) scale(1.3, 1.12);
    }
  }

  @keyframes lobe-b {
    from {
      transform: translate(14%, -16%) rotate(14deg) scale(0.75, 0.65);
    }
    to {
      transform: translate(-12%, 15%) rotate(-12deg) scale(1.25, 1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .blob::before,
    .blob::after,
    .lobe {
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(96px, 5.3vw + 40px, 128px);
    padding-left: clamp(1rem, 4vw, 57px);
  }

  .hero-title {
    font-size: var(--fs-title);
    letter-spacing: var(--tracking-title);
    line-height: 1.17;
  }

  .hero-sub {
    font-size: var(--fs-lead);
    letter-spacing: var(--tracking-lead);
    line-height: 1.5;
  }

  .hero-lang {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    top: 44px;
    right: 26px;
  }

  /* below ~860px the blob reaches the top-right corner, so the switch starts white. Once the page runs, the script
     below follows the moving blob and sets data-ink: light ink while blue is behind the switch, brand blue on white */
  @media (max-width: 860px) {
    .hero-lang {
      --lang-ink: var(--color-text-inverse);
    }
  }

  .hero-lang[data-ink='light'] {
    --lang-ink: var(--color-text-inverse);
  }

  .hero-lang[data-ink='dark'] {
    --lang-ink: var(--color-brand-ink);
  }

  .hero-lang :global(.lang),
  .hero-lang :global(.theme-btn) {
    transition:
      color 400ms var(--ease),
      background var(--dur) var(--ease);
  }

  @media (max-width: 720px) {
    .hero-lang {
      top: 14px;
      right: 12px;
    }
    /* phones: the blob fills most of the first screen and fades out just before the big name below */
    .blob {
      left: -50%;
      top: -80px;
      width: 200%;
      aspect-ratio: auto;
      height: max(440px, calc(100svh - 20px)); /* never shorter than the text needs on narrow phones */
    }
    .blob::before,
    .blob::after,
    .lobe {
      filter: blur(45px);
    }
  }
</style>
