---
// "Hey!" intro with the blurred blue blob and the language switch (Figma: Intro).
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<header class="hero" id="top">
  <div class="blob" aria-hidden="true"></div>
  <div class="hero-inner container">
    <h1 class="hero-title">{s.heroTitle}</h1>
    <p class="hero-sub">
      {s.heroSub1}<br />
      {s.heroSub2}
    </p>
  </div>
  <div class="hero-lang">
    <ThemeSwitch lang={lang} />
    <LangSwitch lang={lang} />
  </div>
</header>

<style>
  .hero {
    position: relative;
    /* the intro fills the first screen, so only the very top of the big name below peeks out at the bottom edge,
       like a hint to scroll (and it can't be read before recruiter mode is chosen). The name starts the About
       section's top padding plus ~0.14em of line spacing below the hero, and its capitals start ~0.35em into its
       line box: showing ~0.5em of it shows only the top fifth of the capitals. Never shorter than the Figma height on wide, short windows. */
    --name-peek: calc(clamp(16px, 2vw, 28px) + 0.79 * var(--fs-title));
    min-height: max(clamp(420px, 40vw, 597px), calc(100vh - var(--name-peek)));
    min-height: max(clamp(420px, 40vw, 597px), calc(100svh - var(--name-peek)));
    /* let the blurred blob fade out below the hero, but never cause sideways scrolling */
    overflow-x: clip;
    overflow-y: visible;
    color: var(--color-text-inverse);
  }

  /* Blurred ellipse: 1195×709 at (-223, -184) in the 1440 frame */
  .blob {
    position: absolute;
    /* follow the centred content column on screens wider than 1440px */
    left: calc(max(0px, (100% - var(--content-max)) / 2) - min(15.5vw, 223px));
    top: -184px;
    /* 1195px wide in Figma; never smaller than ~980px so the white text always sits on blue */
    width: max(83%, 980px);
    max-width: 1195px;
    aspect-ratio: 1195 / 709;
    /* on tall windows the glow stretches down with the intro and fades out just above the name */
    min-height: calc(100% + 104px);
    translate: var(--tilt-x, 0) var(--tilt-y, 0); /* a tilted phone moves the glow (ArrowBugs.astro) */
    transition: translate 400ms ease-out;
    will-change: transform;
    /* breathes: drifts a little side to side and swells, slow enough not to distract */
    animation: hero-breathe 9s ease-in-out infinite alternate;
  }

  @keyframes hero-breathe {
    0% {
      transform: translate3d(-3%, 12px, 0) rotate(-2deg) scale(1);
    }
    45% {
      transform: translate3d(2.5%, -22px, 0) rotate(1.5deg) scale(1.07);
    }
    100% {
      transform: translate3d(4%, 6px, 0) rotate(3deg) scale(1.03);
    }
  }


  /* the wave: two blurred copies of the shape, a little lopsided, turning and stretching out of step. Only their
     transform moves (the graphics card does it), so the blur is drawn once and the page stays smooth */
  .blob::before,
  .blob::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-block);
    filter: blur(80px);
    will-change: transform;
  }

  .blob::before {
    border-radius: 58% 42% 55% 45% / 46% 54% 42% 58%;
    animation: wave-a 7s ease-in-out infinite alternate;
  }

  .blob::after {
    border-radius: 42% 58% 47% 53% / 56% 44% 60% 40%;
    animation: wave-b 9s ease-in-out infinite alternate;
  }

  @keyframes wave-a {
    from {
      transform: rotate(-5deg) scale(1.04, 0.96);
    }
    to {
      transform: rotate(5deg) scale(0.97, 1.04);
    }
  }

  @keyframes wave-b {
    from {
      transform: rotate(6deg) scale(0.96, 1.04);
    }
    to {
      transform: rotate(-5deg) scale(1.05, 0.96);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob,
    .blob::before,
    .blob::after {
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(96px, 5.3vw + 40px, 128px);
    padding-left: clamp(1rem, 4vw, 57px);
  }

  .hero-title {
    font-size: var(--fs-title);
    letter-spacing: var(--tracking-title);
    line-height: 1.17;
  }

  .hero-sub {
    font-size: var(--fs-lead);
    letter-spacing: var(--tracking-lead);
    line-height: 1.5;
  }

  .hero-lang {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    top: 44px;
    right: 26px;
  }

  /* below ~860px the blob reaches the top-right corner, so the switch turns white */
  @media (max-width: 860px) {
    .hero-lang {
      --lang-ink: var(--color-text-inverse);
    }
  }

  @media (max-width: 720px) {
    .hero-lang {
      top: 14px;
      right: 12px;
    }
    /* phones: the blob fills most of the first screen and fades out just before the big name below */
    .blob {
      left: -50%;
      top: -80px;
      width: 200%;
      aspect-ratio: auto;
      height: max(440px, calc(100svh - 20px)); /* never shorter than the text needs on narrow phones */
      min-height: 0;
    }
    .blob::before,
    .blob::after {
      filter: blur(45px);
    }
  }
</style>
