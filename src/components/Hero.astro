---
// "Hey!" intro with the blurred blue blob and the language switch (Figma: Intro).
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<header class="hero" id="top">
  <div class="blob" aria-hidden="true"></div>
  <div class="hero-inner container">
    <h1 class="hero-title">{s.heroTitle}</h1>
    <p class="hero-sub">
      {s.heroSub1}<br />
      {s.heroSub2}
    </p>
  </div>
  <div class="hero-lang">
    <ThemeSwitch lang={lang} />
    <LangSwitch lang={lang} />
  </div>
</header>

<style>
  .hero {
    position: relative;
    min-height: clamp(420px, 40vw, 597px);
    /* let the blurred blob fade out below the hero, but never cause sideways scrolling */
    overflow-x: clip;
    overflow-y: visible;
    color: var(--color-text-inverse);
  }

  /* Blurred ellipse: 1195×709 at (-223, -184) in the 1440 frame */
  .blob {
    position: absolute;
    /* follow the centred content column on screens wider than 1440px */
    left: calc(max(0px, (100% - var(--content-max)) / 2) - min(15.5vw, 223px));
    top: -184px;
    /* 1195px wide in Figma; never smaller than ~980px so the white text always sits on blue */
    width: max(83%, 980px);
    max-width: 1195px;
    aspect-ratio: 1195 / 709;
    border-radius: 50%;
    background: var(--color-block);
    filter: blur(80px); /* a little less blur than Figma's 100px, so the wavy edge shows */
    translate: var(--tilt-x, 0) var(--tilt-y, 0); /* a tilted phone moves the glow (ArrowBugs.astro) */
    transition: translate 400ms ease-out;
    transform: translateZ(0);
    /* breathes: drifts a little side to side and swells, slow enough not to distract */
    animation:
      hero-breathe 9s ease-in-out infinite alternate,
      blob-wave 7s ease-in-out infinite;
  }

  @keyframes hero-breathe {
    0% {
      transform: translate3d(-3%, 12px, 0) rotate(-2deg) scale(1);
    }
    45% {
      transform: translate3d(2.5%, -22px, 0) rotate(1.5deg) scale(1.07);
    }
    100% {
      transform: translate3d(4%, 6px, 0) rotate(3deg) scale(1.03);
    }
  }

  /* the edge ripples: the ellipse's four corners swell and shrink out of step, like a slow wave */
  @keyframes blob-wave {
    0% {
      border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
    }
    25% {
      border-radius: 58% 42% 55% 45% / 44% 56% 46% 54%;
    }
    50% {
      border-radius: 44% 56% 46% 54% / 56% 44% 58% 42%;
    }
    75% {
      border-radius: 55% 45% 60% 40% / 47% 53% 43% 57%;
    }
    100% {
      border-radius: 50% 50% 50% 50% / 50% 50% 50% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blob {
      animation: none;
    }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    padding-top: clamp(96px, 5.3vw + 40px, 128px);
    padding-left: clamp(1rem, 4vw, 57px);
  }

  .hero-title {
    font-size: var(--fs-title);
    letter-spacing: var(--tracking-title);
    line-height: 1.17;
  }

  .hero-sub {
    font-size: var(--fs-lead);
    letter-spacing: var(--tracking-lead);
    line-height: 1.5;
  }

  .hero-lang {
    position: absolute;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 10px;
    top: 44px;
    right: 26px;
  }

  /* below ~860px the blob reaches the top-right corner, so the switch turns white */
  @media (max-width: 860px) {
    .hero-lang {
      --lang-ink: var(--color-text-inverse);
    }
  }

  @media (max-width: 720px) {
    /* phones: the blue intro takes most of the first screen and the big name below starts on white (never black
       on blue), at the bottom of the screen: there's time to notice the recruiter pop-up first */
    .hero {
      min-height: 70vh;
      min-height: 70svh;
    }
    .hero-lang {
      top: 14px;
      right: 12px;
    }
    /* phones: a smaller blob, just big enough for the white text to sit on blue; it fades out well before the
       big name below */
    .blob {
      left: -50%;
      top: -80px;
      width: 200%;
      /* a fixed height, so the longer wrapped text on narrow phones is still on blue */
      aspect-ratio: auto;
      height: 440px;
      filter: blur(45px);
    }
  }
</style>
