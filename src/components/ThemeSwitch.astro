---
// Colour theme button, next to EN / IT. One button that cycles Automatic (follows the device) → Light → Dark.
// The choice is kept in this browser (localStorage "theme") and applied before the page paints by the small
// script in BaseLayout, which sets html[data-theme]. Colours: src/styles/tokens.css.
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
const names = { auto: s.themeAuto, light: s.themeLight, dark: s.themeDark };
---

<button
  type="button"
  class="theme-btn"
  data-theme-btn
  data-name={s.themeName}
  data-names={JSON.stringify(names)}
  aria-label={`${s.themeName}: ${s.themeAuto}`}
  data-cursor={`${s.themeName}: ${s.themeAuto}`}>
  <!-- automatic: half light, half dark -->
  <svg class="i i-auto" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="2"></circle>
    <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor"></path>
  </svg>
  <!-- light: sun -->
  <svg class="i i-light" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <circle cx="12" cy="12" r="4.2" fill="currentColor"></circle>
    <path
      d="M12 2.5v2.6M12 18.9v2.6M2.5 12h2.6M18.9 12h2.6M5.3 5.3l1.8 1.8M16.9 16.9l1.8 1.8M5.3 18.7l1.8-1.8M16.9 7.1l1.8-1.8"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"></path>
  </svg>
  <!-- dark: moon -->
  <svg class="i i-dark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
    <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="currentColor"></path>
  </svg>
</button>
<span class="visually-hidden" aria-live="polite" data-theme-status></span>

<script>
  type Mode = 'auto' | 'light' | 'dark';
  const ORDER: Mode[] = ['auto', 'light', 'dark'];
  const html = document.documentElement;
  const current = (): Mode => (html.dataset.theme === 'light' || html.dataset.theme === 'dark' ? html.dataset.theme : 'auto');

  document.querySelectorAll<HTMLButtonElement>('[data-theme-btn]').forEach((btn) => {
    const names = JSON.parse(btn.dataset.names ?? '{}') as Record<Mode, string>;
    const status = btn.nextElementSibling as HTMLElement | null;
    const label = () => {
      const text = `${btn.dataset.name}: ${names[current()]}`;
      btn.setAttribute('aria-label', text);
      btn.dataset.cursor = text;
      return text;
    };
    label();
    btn.addEventListener('click', () => {
      const next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
      if (next === 'auto') delete html.dataset.theme;
      else html.dataset.theme = next;
      try {
        if (next === 'auto') localStorage.removeItem('theme');
        else localStorage.setItem('theme', next);
      } catch {
        /* storage blocked: this page only */
      }
      const text = label();
      if (status) status.textContent = text;
      document.dispatchEvent(new Event('theme-change')); // e.g. the pointer label refreshes its text
    });
  });
</script>

<style>
  .theme-btn {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    color: var(--lang-ink, var(--color-brand-ink));
    cursor: pointer;
    transition: background var(--dur) var(--ease);
  }

  .theme-btn:hover {
    background: color-mix(in srgb, currentColor 14%, transparent);
  }

  .i {
    display: none;
  }

  /* the icon shows the mode in use */
  :global(html:not([data-theme])) .i-auto,
  :global(html[data-theme='light']) .i-light,
  :global(html[data-theme='dark']) .i-dark {
    display: block;
  }

  /* touch screens: a bigger tap area, same look */
  @media (pointer: coarse) {
    .theme-btn {
      width: 40px;
      height: 40px;
    }
  }
</style>
