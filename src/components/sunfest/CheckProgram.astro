---
// "Check the program" block (lineup and FAQs pages)
import { Image } from 'astro:assets';
import teaser from '../../assets/sunfest25/img/program-teaser.jpg';
---

<section class="sf-section sf-wrap sf-promo sf-promo--image-first" aria-labelledby="sf-check-program">
  <div>
    <h2 id="sf-check-program" class="sf-promo__title">Check the program</h2>
    <p>Curious about set times? Check out our Program page for the full schedule!</p>
    <a class="sf-btn" href="/sunfest25/program/">Go to Program</a>
  </div>
  <div class="sf-promo__media">
    <Image class="sf-photo" src={teaser} alt="A concert crowd seen from behind, facing a stage lit by white spotlights" widths={[480, 800, 1200]} sizes="(max-width: 720px) 92vw, 560px" />
  </div>
</section>
