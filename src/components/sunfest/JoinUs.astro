---
// "Join us!" call for volunteers (overnight, volunteer and about pages)
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import joinPhoto from '../../assets/sunfest25/img/join-us.jpg';

interface Props {
  lead?: string;
  image?: ImageMetadata;
  alt?: string;
  /** on the volunteer page the button can't go anywhere else */
  proto?: boolean;
}
const {
  lead = 'The call is always open',
  image = joinPhoto,
  alt = 'Volunteers sorting and handing out food at a stand',
  proto = false,
} = Astro.props;
---

<section class="sf-section sf-wrap sf-promo" aria-labelledby="sf-join">
  <div>
    <h2 id="sf-join" class="sf-promo__title">Join us!</h2>
    <p class="sf-promo__lead">{lead}</p>
    <slot />
    {
      proto ? (
        <button type="button" class="sf-btn" data-proto="Sunfest is fictional, so there is no team to join (yet!).">
          Join the team!
        </button>
      ) : (
        <a class="sf-btn" href="/sunfest25/volunteer/">
          Join the team!
        </a>
      )
    }
  </div>
  <div class="sf-promo__media">
    <Image class="sf-photo" src={image} alt={alt} widths={[480, 800, 1200]} sizes="(max-width: 720px) 92vw, 560px" />
  </div>
</section>
