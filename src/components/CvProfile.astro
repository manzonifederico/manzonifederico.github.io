---
// Photo + name + contacts + locations (Figma: CV Profile, "Contacts in line + location").
import { Image } from 'astro:assets';
import profile from '../assets/profile/profile.png';
import { site, contact, siteText } from '../data/site';
import { cvProfile } from '../data/cv';
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t(lang);
---

<div class="profile">
  <div class="photo-col">
    <!-- hover (normal mode only, hidden in recruiter mode like the other personal notes): where the photo was taken -->
    <div
      class="photo-frame"
      data-cursor={lang === 'it' ? 'Scattata sul Lago di Garda' : 'Taken at Lake Garda'}
      data-cursor-pii>
      <Image class="photo pii pii-photo" src={profile} alt={s.photoAlt} width={200} height={200} densities={[1, 2]} />
    </div>
    <button
      type="button"
      class="photo-btn"
      data-photo-toggle
      data-label-hide={s.hidePhoto}
      data-label-show={s.showPhoto}>
      <svg class="icon icon-shown" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          fill="currentColor"
          d="M12 16q1.875 0 3.188-1.312T16.5 11.5t-1.312-3.187T12 7T8.813 8.313T7.5 11.5t1.313 3.188T12 16m0-1.8q-1.125 0-1.912-.788T9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2m0 4.8q-3.65 0-6.65-2.037T1 11.5q1.35-3.425 4.35-5.462T12 4t6.65 2.038T23 11.5q-1.35 3.425-4.35 5.463T12 19"
        ></path>
      </svg>
      <svg class="icon icon-hidden" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path
          fill="currentColor"
          d="m16.1 13.3l-1.45-1.45q.225-1.175-.675-2.2t-2.325-.8L10.2 7.4q.425-.2.863-.3T12 7q1.875 0 3.188 1.313T16.5 11.5q0 .5-.1.938t-.3.862m3.2 3.15l-1.45-1.4q.95-.725 1.688-1.587T20.8 11.5q-1.25-2.525-3.588-4.012T12 6q-.725 0-1.425.1T9.2 6.4L7.65 4.85q1.025-.425 2.1-.638T12 4q3.775 0 6.725 2.087T23 11.5q-.575 1.475-1.513 2.738T19.3 16.45m.5 6.15l-4.2-4.15q-.875.275-1.762.413T12 19q-3.775 0-6.725-2.087T1 11.5q.525-1.325 1.325-2.463T4.15 7L1.4 4.2l1.4-1.4l18.4 18.4z"
        ></path>
      </svg>
      <span data-label>{s.hidePhoto}</span>
    </button>
  </div>

  <div class="details">
    <p class="name">
      <!-- in recruiter mode the name shows again together with the photo and contacts -->
      <span class="pii pii-profile-name">{site.name}</span>
      <span class="pii-placeholder pii-profile-name-ph">{s.nameHidden}</span>
    </p>
    <p class="role">{siteText[lang].role}</p>
    <p class="bio" set:html={cvProfile[lang]} />
    <ul class="contacts pii pii-contact" role="list">
      {
        contact.emails.map((email) => (
          <li>
            <a href={`mailto:${email}`} data-cursor={s.cursorWrite}>{email}</a>
          </li>
        ))
      }
      <li>
        <a class="badge-link" href={contact.linkedin} rel="me noopener" target="_blank" data-cursor={s.cursorConnect}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect width="24" height="24" rx="4" fill="#0A66C2"></rect>
            <path
              fill="#fff"
              d="M6.94 9.5H4.56V19h2.38V9.5zM5.75 5.5a1.38 1.38 0 1 0 0 2.76 1.38 1.38 0 0 0 0-2.76zM19.5 13.7c0-2.46-1.31-3.6-3.06-3.6-1.41 0-2.04.78-2.39 1.32V9.5h-2.38V19h2.38v-4.7c0-1.24.23-2.44 1.77-2.44 1.52 0 1.54 1.42 1.54 2.52V19h2.38v-5.3z"
            ></path>
          </svg>
          LinkedIn
          <span class="visually-hidden"> {s.newTab}</span>
        </a>
      </li>
      <li>
        <a class="badge-link" href={contact.orcid} rel="me noopener" target="_blank" data-cursor={s.cursorContact}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <circle cx="12" cy="12" r="12" fill="#A6CE39"></circle>
            <path
              fill="#fff"
              d="M8.1 17.5H6.6V7.4h1.5zm2.2-10.1h4.1c3.9 0 5.6 2.8 5.6 5.1 0 2.5-2 5.1-5.6 5.1h-4.1zm1.5 8.8h2.4c3.4 0 4.2-2.6 4.2-3.8 0-1.9-1.2-3.8-4.2-3.8h-2.4zM8.3 5.4c0 .5-.4 1-1 1s-1-.5-1-1 .4-1 1-1 1 .5 1 1"
            ></path>
          </svg>
          ORCID
          <span class="visually-hidden"> {s.newTab}</span>
        </a>
      </li>
      <li>
        <a class="badge-link" href={contact.researchgate} rel="me noopener" target="_blank" data-cursor={s.cursorContact}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
            <rect width="24" height="24" rx="4" fill="#00CCBB"></rect>
            <text x="12" y="16.5" fill="#fff" font-family="Arial, sans-serif" font-size="11" font-weight="700" text-anchor="middle">RG</text>
          </svg>
          ResearchGate
          <span class="visually-hidden"> {s.newTab}</span>
        </a>
      </li>
      {contact.github && <li><a href={contact.github} rel="me noopener" target="_blank" data-cursor={s.cursorContact}>GitHub<span class="visually-hidden"> {s.newTab}</span></a></li>}
    </ul>
    <ul class="locations pii pii-contact" role="list">
      {contact.locations[lang].map((loc) => <li>{loc}</li>)}
    </ul>
  </div>
</div>

<style>
  .profile {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 34px;
  }

  .photo-col {
    width: 246px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }

  .photo-frame {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    border: 1px solid var(--color-brand-ink);
    overflow: hidden;
  }

  .photo-frame :global(.photo) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: filter var(--dur) var(--ease);
  }

  .photo-btn {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 10px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--color-brand-ink);
    font-weight: 500;
    font-size: var(--fs-small);
    cursor: pointer;
  }

  .photo-btn:hover {
    border-color: var(--color-brand-ink);
  }

  .icon-hidden,
  .photo-btn[data-state='hidden'] .icon-shown {
    display: none;
  }

  .photo-btn[data-state='hidden'] .icon-hidden {
    display: block;
  }

  .details {
    flex: 1 1 320px;
    min-width: 0;
    display: grid;
    gap: 10px;
  }

  .name {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 4rem);
    font-weight: 500;
    line-height: 1.17;
  }

  .role {
    margin-top: 2px;
    font-size: clamp(1.05rem, 0.95rem + 0.4vw, 1.3rem);
    font-weight: 500;
    color: var(--color-brand-ink);
  }

  .bio {
    max-width: 1200px; /* uses the full width beside the photo */
    margin: 10px 0 14px;
    font-size: var(--fs-support, 1rem);
    font-weight: 300;
    line-height: 1.5;
  }

  .contacts,
  .locations {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: var(--fs-support);
    font-weight: 300;
  }

  .contacts {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 48px;
    margin-top: -5px;
  }

  .contacts a {
    text-underline-offset: 2px;
  }

  .badge-link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .badge-link svg {
    flex: none;
  }

  .locations {
    line-height: 1.4;
  }

  @media (max-width: 720px) {
    .profile {
      flex-direction: column;
      align-items: flex-start;
      gap: 16px;
    }
    .photo-col {
      width: auto;
      align-items: flex-start;
    }
    .contacts {
      flex-direction: column;
      gap: 6px;
    }
  }
</style>
