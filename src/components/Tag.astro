---
// A small pill label (e.g. "UX/UI Design"). Colours come from the project theme.
// `note` (optional): a label that follows the pointer on hover (src/scripts/view-cursor.ts), e.g. the university
// on "Uni Project"; `noteFlag`: a small logo or flag after it (FLAGS in view-cursor.ts).
interface Props {
  label: string;
  note?: string;
  noteFlag?: string;
}
const { label, note, noteFlag } = Astro.props;
---

<li class="tag" data-cursor={note} data-cursor-flag={noteFlag}>{label}</li>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 8px;
    text-shadow: none;
    border-radius: var(--radius-pill);
    background: var(--theme-tag-bg, var(--color-fill));
    color: var(--theme-tag-ink, var(--color-on-fill));
    font-family: 'Manrope', system-ui, sans-serif;
    font-weight: 500;
    font-size: var(--fs-small);
    line-height: 1.2;
    white-space: nowrap;
  }
</style>
