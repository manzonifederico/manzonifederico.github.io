---
// Case-study page, shared by /work/<slug>/ (English) and /it/work/<slug>/ (Italian UI;
// the article text itself is in English).
import { getCollection, render } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectLogo from '../ProjectLogo.astro';
import ProjectCard from '../ProjectCard.astro';
import LangSwitch from '../LangSwitch.astro';
import ThemeSwitch from '../ThemeSwitch.astro';
import Tag from '../Tag.astro';
import MyWork from '../MyWork.astro';
import Footer from '../Footer.astro';
import { getProject, projectText, type Project } from '../../data/projects';
import { site } from '../../data/site';
import { t, tagLabel, localePath, type Lang } from '../../i18n/ui';
import '../../styles/death.css'; // the souls-like screen of the brainrot easter egg (Instagram)

interface Props {
  project: Project;
  lang: Lang;
}
const { project, lang } = Astro.props;
const s = t(lang);
// a hover label on the title of some projects: a "did you know" when the name has a story, a joke on Instagram
// (not clickable: normal pointer)
const TITLE_NOTES: Record<string, Record<Lang, string>> = {
  agora: {
    en: 'Did you know? In ancient Greek, agorà is the city’s public square',
    it: 'Lo sapevi? In greco antico l’agorà è la piazza pubblica della città',
  },
  cicerone: {
    en: 'Did you know? Cicero was a Roman orator: tour guides are called cicerones after him',
    it: 'Lo sapevi? Cicerone era un oratore romano: da lui le guide turistiche si chiamano ciceroni',
  },
  'instagram-redesign': {
    en: 'Mark wouldn’t like this',
    it: 'A Mark non piacerebbe',
  },
  'bk-vs-mc': {
    en: 'Basically good fries vs Crispy McBacon :0',
    it: 'In pratica patatine buone vs Crispy McBacon :0',
  },
};
const titleNote = TITLE_NOTES[project.slug]?.[lang];
// Instagram: hovering "brainrot" in the subtitle shows one of the Italian brainrot characters, a new one each time.
// The three favourites come up more often (each is in the list four times: together about half the picks)
const FAVOURITES = ['Bombardiro Crocodilo', 'Tung Tung Tung Sahur', 'Ballerina Cappuccina'];
const BRAINROT = [
  ...FAVOURITES,
  ...FAVOURITES,
  ...FAVOURITES,
  'Tralalero Tralala',
  'Bombardiro Crocodilo',
  'Tung Tung Tung Sahur',
  'Ballerina Cappuccina',
  'Brr Brr Patapim',
  'Lirilì Larilà',
  'Chimpanzini Bananini',
  'Bombombini Gusini',
  'Trippi Troppi',
  'Cappuccino Assassino',
  'Frigo Camelo',
  'Boneca Ambalabu',
  'La Vaca Saturno Saturnita',
  'Glorbo Fruttodrillo',
];
const text = projectText(project, lang);
const subParts = project.slug === 'instagram-redesign' ? text.subtitle.split(/(brainrot)/i) : [text.subtitle];

const entries = await getCollection('articles', (e) => e.id.startsWith(`${project.slug}/`));
const byVersion = Object.fromEntries(entries.map((e) => [e.id.split('/')[1], e]));

type VersionKey = 'full' | 'key-points' | 'summary';
// Italian pages use full-it.md / key-points-it.md / summary-it.md when they exist, else the English text
const entryFor = (k: VersionKey) => (lang === 'it' && byVersion[`${k}-it`]) || byVersion[k];
// order of the reading-mode tabs; the first one is the one the page opens on
const versions = (['key-points', 'full', 'summary'] as VersionKey[])
  .filter((k) => byVersion[k])
  .map((key) => ({ key, label: s.modes[key] }));
const allTranslated = lang !== 'it' || versions.every((v) => byVersion[`${v.key}-it`]);

const rendered = await Promise.all(
  versions.map(async (v) => {
    const entry = entryFor(v.key);
    const r = await render(entry);
    // optional front matter `legend:` maps a heading to a shorter label for the quick links on the left
    const short = (entry.data?.legend ?? {}) as Record<string, string>;
    const headings = r.headings.filter((h) => h.depth === 2).map((h) => ({ ...h, text: short[h.text] ?? h.text }));
    // rough reading time shown on the tab (about 220 words a minute)
    const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
    const minutes = Math.max(1, Math.round(words / 220));
    return { ...v, Content: r.Content, headings, minutes, lang: entry === byVersion[v.key] ? 'en' : 'it' };
  }),
);
const bibliography = byVersion['bibliography'] ? await render(byVersion['bibliography']) : null;
const Bibliography = bibliography?.Content;

// opens on the first mode (Key points)
const defaultMode: VersionKey = rendered[0].key;
const related = project.related ? getProject(project.related) : undefined;

// ---------- SEO ----------
const pageTitle = `${project.title}: ${text.subtitle} | ${site.name}`;
const pageUrl = new URL(localePath(lang, `/work/${project.slug}/`), Astro.site).href;
// social preview: a landscape screenshot of the project (cropped to 1200×630), else the site's default image
const wide = project.cardImages.find((c) => c.kind === 'desktop' || c.kind === 'screen');
const og = wide ? await getImage({ src: wide.src, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg', layout: 'none' }) : null;
const ogImage = og ? og.src : site.ogImage;
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: `${project.title}: ${text.subtitle}`,
      description: text.description,
      url: pageUrl,
      inLanguage: lang,
      image: new URL(ogImage, Astro.site).href,
      keywords: project.tags.join(', '),
      author: { '@type': 'Person', name: site.name, url: new URL('/', Astro.site).href },
      isPartOf: { '@type': 'WebSite', name: site.name, url: new URL('/', Astro.site).href },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: site.name, item: new URL(localePath(lang, '/'), Astro.site).href },
        { '@type': 'ListItem', position: 2, name: project.title, item: pageUrl },
      ],
    },
  ],
};
---

<BaseLayout
  lang={lang}
  title={pageTitle}
  description={text.description}
  type="article"
  image={og?.src}
  imageAlt={wide?.alt}
  bodyClass={project.theme}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(articleJsonLd).replace(/</g, '\\u003c')} />
  <main id="main">
    <article class="case">
      <div class="case-panel">
        <div class="topbar container">
          <a class="back" href={localePath(lang, '/') + '#work'}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
              <path fill="currentColor" d="m7.825 13l5.6 5.6L12 20l-8-8l8-8l1.425 1.4l-5.6 5.6H20v2z"></path>
            </svg>
            {s.back}
          </a>
          <div class="top-right">
            <ThemeSwitch lang={lang} />
            <LangSwitch lang={lang} />
          </div>
        </div>

        <header class="case-head container" id="start">
          <h1 class="case-title" data-cursor={titleNote}><ProjectLogo project={project} size="hero" /></h1>
          <p class="case-sub">
            {subParts.map((part, i) =>
              i % 2 ? (
                <span data-cursor={BRAINROT[0]} data-cursor-random={JSON.stringify(BRAINROT)} data-brainrot>{part}</span>
              ) : (
                part
              ),
            )}
          </p>
          <ul class="tags" role="list" aria-label={s.tags}>
            {project.tags.map((tag) => (
              <Tag
                label={tagLabel(lang, tag)}
                note={tag === 'Uni Project' ? (lang === 'it' ? 'Università di Trento' : 'University of Trento') : undefined}
              />
            ))}
          </ul>
        </header>

        <div class="case-layout container">
          <!-- Linked legend: Start → sections of the current version → End -->
          <nav class="legend" aria-label={s.contents}>
            <details class="legend-box" data-legend>
              <summary
                data-cursor={lang === 'it' ? 'Mostra indice' : 'Show index'}
                data-cursor-open={lang === 'it' ? 'Nascondi indice' : 'Hide index'}
                data-cursor-closed={lang === 'it' ? 'Mostra indice' : 'Show index'}>{s.contents}</summary
              >
              <ol class="legend-list" role="list">
                <li><a href="#start" data-legend-link>{s.start}</a></li>
                {
                  rendered.map((v) =>
                    v.headings.map((h) => (
                      <li data-legend-for={v.key} hidden={v.key !== defaultMode} lang={v.lang}>
                        <a href={`#${h.slug}`} data-legend-link>
                          {h.text}
                        </a>
                      </li>
                    )),
                  )
                }
                <li><a href="#end" data-legend-link>{s.end}</a></li>
              </ol>
            </details>
          </nav>

          <div class="reader">
            <h2 class="reader-q" id="reader-q">{s.readHow}</h2>
            <p class="reader-hint" id="reader-hint">{s.readHowHint}</p>
            <div class="modes" role="tablist" aria-labelledby="reader-q" aria-describedby="reader-hint">
              {
                rendered.map((v) => (
                  <button
                    type="button"
                    role="tab"
                    class="mode"
                    id={`tab-${v.key}`}
                    aria-controls={`panel-${v.key}`}
                    aria-selected={v.key === defaultMode ? 'true' : 'false'}
                    tabindex={v.key === defaultMode ? 0 : -1}
                    data-mode={v.key}
                    data-cursor={s.modeCursor[v.key]}>
                    <span class="mode-name">{v.label}</span>
                    <span class="mode-time">{s.minRead.replace('{n}', String(v.minutes))}</span>
                  </button>
                ))
              }
            </div>

            {s.englishOnly && !allTranslated && <p class="en-only">{s.englishOnly}</p>}

            <!-- Reviewer mode only: reveal people's names on this page (one switch for all names) -->
            <button
              type="button"
              class="names-btn"
              data-names-toggle
              data-label-show={s.showNames}
              data-label-hide={s.hideNames}>
              <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                <path
                  fill="currentColor"
                  d="M12 16q1.875 0 3.188-1.312T16.5 11.5t-1.312-3.187T12 7T8.813 8.313T7.5 11.5t1.313 3.188T12 16m0-1.8q-1.125 0-1.912-.788T9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2m0 4.8q-3.65 0-6.65-2.037T1 11.5q1.35-3.425 4.35-5.462T12 4t6.65 2.038T23 11.5q-1.35 3.425-4.35 5.463T12 19"
                />
              </svg>
              <span data-names-label>{s.showNames}</span>
            </button>

            {
              rendered.map((v) => (
                <section
                  class="prose"
                  role="tabpanel"
                  id={`panel-${v.key}`}
                  aria-labelledby={`tab-${v.key}`}
                  data-panel={v.key}
                  tabindex="0"
                  lang={v.lang}
                  hidden={v.key !== defaultMode}>
                  <v.Content />
                </section>
              ))
            }

            {
              Bibliography && (
                <details class="biblio" lang="en">
                  <summary>{s.references}</summary>
                  <div class="prose prose--small">
                    <Bibliography />
                  </div>
                </details>
              )
            }

            <footer class="credits" id="end">
              <div>
                <!-- the same "Show names" switch next to the team, so the names can be revealed right where they are -->
                <div class="credits-head">
                  <h2 class="credits-title">{s.team}</h2>
                  <button
                    type="button"
                    class="names-btn names-btn--team"
                    data-names-toggle
                    data-label-show={s.showNames}
                    data-label-hide={s.hideNames}>
                    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                      <path fill="currentColor" d="M12 16q1.875 0 3.188-1.312T16.5 11.5t-1.312-3.187T12 7T8.813 8.313T7.5 11.5t1.313 3.188T12 16m0-1.8q-1.125 0-1.912-.788T9.3 11.5t.788-1.912T12 8.8t1.913.788t.787 1.912t-.787 1.913T12 14.2m0 4.8q-3.65 0-6.65-2.037T1 11.5q1.35-3.425 4.35-5.462T12 4t6.65 2.038T23 11.5q-1.35 3.425-4.35 5.463T12 19" />
                    </svg>
                    <span data-names-label>{s.showNames}</span>
                  </button>
                </div>
                <ul role="list">
                  {project.team.map((m) => {
                    // "Name (role)" → the name is blurred in reviewer mode, the role stays readable
                    const [, name, role] = m.match(/^(.*?)(\s*\(.*\))?$/) ?? [m, m, ''];
                    return (
                      <li>
                        <span class="pii pii-name">{name}</span>
                        {role}
                      </li>
                    );
                  })}
                </ul>
              </div>
              {
                project.resources.length > 0 && (
                  <div>
                    <h2 class="credits-title">{s.resources}</h2>
                    <ul role="list">
                      {project.resources.map((r) => (
                        <li>
                          <a href={r.href} target="_blank" rel="noopener">
                            {r.label}
                            <span class="visually-hidden"> {s.newTab}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                )
              }
            </footer>
          </div>
        </div>
      </div>
    </article>

    <p class="home-link"><a href={localePath(lang, '/')} data-cursor={lang === 'it' ? 'Vai alla home' : 'Go to home page'}>{s.goHome}</a></p>

    {
      related && (
        <section class="related container" aria-labelledby="related-title">
          <h2 id="related-title" class="related-title">
            {s.related}
          </h2>
          <div class="work-list" data-view="list">
            <ProjectCard project={related} lang={lang} headingLevel="h3" />
          </div>
        </section>
      )
    }

    <MyWork lang={lang} exclude={project.slug} defaultView="list" level="h2" filters={false} />
  </main>
  <Footer lang={lang} />

  <!-- Click-to-enlarge for article images (only images with more detail than shown) -->
  <dialog class="lightbox" aria-label={s.enlarge} data-lightbox data-label={s.enlarge}>
    <button type="button" class="lightbox-close" data-lightbox-close aria-label={s.closeImage}>×</button>
    <figure>
      <img alt="" data-lightbox-img />
      <figcaption data-lightbox-caption aria-hidden="true"></figcaption>
    </figure>
  </dialog>
  {
    /* Instagram easter egg: click "brainrot" in the subtitle 10 times in a row and a brainrot character kills you,
       souls-style (the same screen as the arrow game on the home page, styles in src/styles/death.css) */
    project.slug === 'instagram-redesign' && (
      <dialog
        class="death"
        aria-labelledby="brainrot-death-title"
        aria-describedby="brainrot-death-sub"
        data-brainrot-death
        data-killed={lang === 'it' ? '{name} ti ha ucciso' : '{name} killed you'}
        data-names={JSON.stringify(BRAINROT)}>
        <div class="death-band">
          {/* Tung Tung Tung Sahur and Lirilì Larilà don't kill you: their video plays instead (see SPECIAL in the script) */}
          <video class="tung-video" src="/video/tung-tung-tung-sahur.mp4" muted playsinline preload="none" hidden />
          <h2 class="death-title" id="brainrot-death-title" />
          <p class="death-sub" id="brainrot-death-sub">
            {lang === 'it'
              ? 'Hai fissato il brainrot troppo a lungo. Ora il brainrot fissa te.'
              : 'You stared at the brainrot for too long. Now the brainrot stares back.'}
          </p>
          <form method="dialog">
            <button class="death-btn" type="submit" autofocus>
              {s.bugsRetry}
            </button>
          </form>
        </div>
      </dialog>
    )
  }
</BaseLayout>

<script>
  // ---------- "Show names" (reviewer mode, this page only) ----------
  {
    // two buttons (top of the article and next to the team) that share one state
    const btns = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-names-toggle]'));
    const setShown = (shown: boolean) => {
      document.body.classList.toggle('names-shown', shown);
      btns.forEach((btn) => {
        btn.dataset.state = shown ? 'shown' : 'hidden';
        const label = btn.querySelector<HTMLElement>('[data-names-label]');
        if (label) label.textContent = (shown ? btn.dataset.labelHide : btn.dataset.labelShow) ?? '';
      });
      // names hidden from screen readers in reviewer mode become readable again while shown
      const unbiased = document.documentElement.dataset.unbiased === 'true';
      document.querySelectorAll<HTMLElement>('.pii-name').forEach((el) => {
        if (unbiased && !shown) el.setAttribute('aria-hidden', 'true');
        else el.removeAttribute('aria-hidden'); // valid ARIA: "true", never empty
        el.toggleAttribute('inert', unbiased && !shown);
      });
    };
    btns.forEach((btn) => btn.addEventListener('click', () => setShown(!document.body.classList.contains('names-shown'))));
    // turning reviewer mode on or off resets the page to "names hidden"
    document.querySelectorAll('[data-unbiased-toggle]').forEach((t) =>
      t.addEventListener('click', () => requestAnimationFrame(() => setShown(false))),
    );
  }

  // ---------- click-to-enlarge ----------
  {
    const box = document.querySelector<HTMLDialogElement>('[data-lightbox]');
    const big = box?.querySelector<HTMLImageElement>('[data-lightbox-img]');
    const caption = box?.querySelector<HTMLElement>('[data-lightbox-caption]');
    let opener: HTMLElement | null = null;
    // the largest file of an image: article images come in several sizes (srcset), the page shows a small one
    const largest = (img: HTMLImageElement) => {
      let best = { url: img.currentSrc || img.src, w: img.naturalWidth };
      for (const part of img.srcset.split(',')) {
        const [url, w] = part.trim().split(/\s+/);
        const width = parseInt(w ?? '', 10);
        if (url && width > best.w) best = { url, w: width };
      }
      return best;
    };
    const open = (img: HTMLImageElement) => {
      if (!box || !big || !caption) return;
      opener = img;
      big.src = largest(img).url;
      big.alt = img.alt;
      caption.textContent = img.alt;
      box.showModal();
    };
    // worth enlarging = the largest file has clearly more pixels than the space it gets on the page
    const setup = (img: HTMLImageElement) => {
      const shown = img.getBoundingClientRect().width;
      const zoomable = shown > 0 && largest(img).w >= Math.max(shown * 1.3, 500);
      img.classList.toggle('zoomable', zoomable);
      if (zoomable) {
        img.tabIndex = 0;
        img.setAttribute('role', 'button');
        img.setAttribute('aria-label', `${box?.dataset.label ?? 'Enlarge'}: ${img.alt}`);
      } else {
        img.removeAttribute('tabindex');
        img.removeAttribute('role');
        img.removeAttribute('aria-label');
      }
    };
    const imgs = Array.from(document.querySelectorAll<HTMLImageElement>('.prose img'));
    const check = () => imgs.forEach((img) => (img.complete ? setup(img) : img.addEventListener('load', () => setup(img), { once: true })));
    check();
    // images in hidden reading modes get their size when shown, so re-check on tab change and resize
    document.addEventListener('reading-mode', () => requestAnimationFrame(check));
    window.addEventListener('resize', () => requestAnimationFrame(check));
    document.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest<HTMLImageElement>('.prose img.zoomable');
      if (img) open(img);
    });
    document.addEventListener('keydown', (e) => {
      const img = (e.target as HTMLElement).closest?.<HTMLImageElement>('.prose img.zoomable');
      if (!img) return;
      if (e.key === 'Enter') {
        e.preventDefault();
        open(img);
      } else if (e.key === ' ') {
        e.preventDefault(); // no page scroll; it opens on keyup
      }
    });
    document.addEventListener('keyup', (e) => {
      const img = (e.target as HTMLElement).closest?.<HTMLImageElement>('.prose img.zoomable');
      if (img && e.key === ' ') open(img);
    });
    box?.querySelector('[data-lightbox-close]')?.addEventListener('click', () => box.close());
    big?.addEventListener('click', () => box?.close());
    box?.addEventListener('click', (e) => {
      if (e.target === box) box.close(); // click outside the image
    });
    box?.addEventListener('close', () => opener?.focus());
  }

  // ---------- Reading modes (Key points / Full story / Summary) ----------
  // #full, #key-points, #summary open that version; a heading anchor opens the version that contains it.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.mode'));
  const panels = Array.from(document.querySelectorAll<HTMLElement>('[data-panel]'));
  const legendItems = Array.from(document.querySelectorAll<HTMLElement>('[data-legend-for]'));

  function select(key: string, focus = false) {
    const tab = tabs.find((t) => t.dataset.mode === key);
    if (!tab) return;
    tabs.forEach((t) => {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
    });
    panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
    legendItems.forEach((li) => (li.hidden = li.dataset.legendFor !== key));
    if (focus) tab.focus();
    spy();
    document.dispatchEvent(new Event('reading-mode'));
  }

  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => {
      select(tab.dataset.mode!);
      history.replaceState(null, '', `#${tab.dataset.mode}`);
    });
    tab.addEventListener('keydown', (e) => {
      const dir = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
      const jump = e.key === 'Home' ? tabs[0] : e.key === 'End' ? tabs[tabs.length - 1] : null;
      if (!dir && !jump) return;
      e.preventDefault();
      const next = jump ?? tabs[(i + dir + tabs.length) % tabs.length];
      select(next.dataset.mode!, true);
    });
  });

  function fromHash() {
    const id = decodeURIComponent(location.hash.slice(1));
    if (!id) return;
    if (tabs.some((t) => t.dataset.mode === id)) {
      select(id);
      document.getElementById('reader-q')?.scrollIntoView();
      return;
    }
    const target = document.getElementById(id);
    const panel = target?.closest<HTMLElement>('[data-panel]');
    if (panel?.dataset.panel) {
      select(panel.dataset.panel);
      target!.scrollIntoView();
    }
  }
  window.addEventListener('hashchange', fromHash);

  // ---------- Legend: open on wide screens, collapsible on small ones; highlight current section ----------
  const legend = document.querySelector<HTMLDetailsElement>('[data-legend]');
  const wide = matchMedia('(min-width: 1180px)');
  const syncLegend = () => legend && (legend.open = wide.matches);
  wide.addEventListener?.('change', syncLegend);
  syncLegend();
  // the pointer label on "On this page" says what a click will do: show or hide the index
  const legendSummary = legend?.querySelector<HTMLElement>('summary');
  const syncLegendLabel = () => {
    if (!legend || !legendSummary) return;
    legendSummary.dataset.cursor = (legend.open ? legendSummary.dataset.cursorOpen : legendSummary.dataset.cursorClosed) ?? '';
    document.dispatchEvent(new Event('cursor-refresh'));
  };
  legend?.addEventListener('toggle', syncLegendLabel);
  syncLegendLabel();

  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-legend-link]'));
  let ticking = false;
  function spy() {
    ticking = false;
    const visible = links.filter((a) => !a.closest('[hidden]'));
    let current = visible[0];
    const line = window.innerHeight * 0.3;
    for (const a of visible) {
      const el = document.getElementById(a.hash.slice(1));
      if (el && el.getBoundingClientRect().top <= line) current = a;
    }
    // reached the bottom of the article → "End"
    const end = document.getElementById('end');
    if (end && end.getBoundingClientRect().top < window.innerHeight * 0.85) current = visible[visible.length - 1];
    links.forEach((a) => (a === current ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
  }
  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(spy);
      }
    },
    { passive: true },
  );
  // on small screens, close the legend after choosing a section
  links.forEach((a) => a.addEventListener('click', () => !wide.matches && legend && (legend.open = false)));

  fromHash();
  spy();

  // ---------- Instagram easter egg: 10 clicks in a row on "brainrot" → "<character> killed you" ----------
  const brainrot = document.querySelector<HTMLElement>('[data-brainrot]');
  const rotDeath = document.querySelector<HTMLDialogElement>('[data-brainrot-death]');
  if (brainrot && rotDeath) {
    let clicks = 0;
    let lastClick = 0;
    let deathSound: HTMLAudioElement | null = null;
    // characters who don't kill you: they show up in their own video (Tenor GIFs as MP4, muted) and say their line
    // (meme audio from MyInstants, cut: Tung's name; Lirilì Larilà's "lirilì larilà, l'elefante che va qua e là").
    // The line plays once with the video, then the video carries on looping in silence.
    const SPECIAL: Record<string, { video: string; audio: string }> = {
      'Tung Tung Tung Sahur': { video: '/video/tung-tung-tung-sahur.mp4', audio: '/audio/tung-tung-tung-sahur.mp3' },
      'Lirilì Larilà': { video: '/video/lirili-larila.mp4', audio: '/audio/lirili-larila.mp3' },
    };
    const NAME_PLAYS = 1; // the line is said once; the video keeps looping in silence
    let voice: HTMLAudioElement | null = null;
    let plays = 0;
    // the sounds here always play: ten clicks in a row are a deliberate request (the arrow game's sound switch on the
    // home page doesn't apply to this easter egg)
    const sayName = () => {
      // at the start of a loop, but never over itself: a line longer than the video (Lirilì Larilà's) waits for the
      // next loop instead of being cut off
      if (!voice || plays >= NAME_PLAYS || (plays > 0 && !voice.ended)) return;
      plays++;
      voice.currentTime = 0;
      voice.play().catch(() => {});
    };
    // the video plays again from the start each time it ends, and the name with it, so they stay in time
    const video = rotDeath.querySelector<HTMLVideoElement>('.tung-video');
    video?.addEventListener('ended', () => {
      if (!rotDeath.open || video.hidden) return;
      video.currentTime = 0;
      video.play().catch(() => {});
      sayName();
    });
    brainrot.addEventListener('click', () => {
      const now = performance.now();
      clicks = now - lastClick < 1200 ? clicks + 1 : 1; // "in a row": at most 1.2 s between clicks
      lastClick = now;
      if (clicks < 10) return;
      clicks = 0;
      // the character in the pointer label right now, or a random one (touch screens have no label)
      const label = document.querySelector('#view-cursor.is-visible .vc-label')?.textContent?.trim();
      const names: string[] = JSON.parse(rotDeath.dataset.names ?? '[]');
      const name = label && names.includes(label) ? label : names[Math.floor(Math.random() * names.length)];
      const special = SPECIAL[name];
      rotDeath.classList.toggle('is-tung', !!special);
      rotDeath.querySelector('.death-title')!.textContent = special
        ? name
        : (rotDeath.dataset.killed ?? '{name}').replace('{name}', name);
      if (video) {
        video.hidden = !special;
        if (special) {
          if (!video.src.endsWith(special.video)) video.src = special.video;
          voice?.pause();
          voice = new Audio(special.audio);
          voice.volume = 0.9;
          plays = 0;
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
            video.currentTime = 0;
            video.play().catch(() => {});
          }
          sayName(); // with reduced motion the video stays still, but the name is still said
        }
      }
      const form = rotDeath.querySelector<HTMLElement>('form');
      if (form) form.inert = true; // the clicks still coming in don't close it straight away
      rotDeath.showModal();
      window.setTimeout(() => {
        if (form) form.inert = false;
        rotDeath.querySelector<HTMLButtonElement>('.death-btn')?.focus();
      }, matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 1700);
      if (special) return;
      // the same "you died" sound as the arrow game
      deathSound ??= new Audio('/audio/you-died.mp3');
      deathSound.volume = 0.9;
      deathSound.currentTime = 0;
      deathSound.play().catch(() => {});
    });
    rotDeath.addEventListener('close', () => {
      deathSound?.pause();
      voice?.pause();
      video?.pause();
    });
  }
</script>

