---
// Easter egg: keep pulling at the very end of the page and the footer stretches a little, like rubber, uncovering a
// faint line under the signature ("Nothing to see here, mate."). Let go and it springs back.
// A finger dragging up on a phone (iPhone or Android), or a trackpad / wheel that keeps going down on a computer.
// The words live in a data attribute and are drawn by CSS (::after), so they can't be selected, copied or found with
// the browser's search, and screen readers skip them (decorative). Pages without the footer: nothing happens.
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="overscroll-note" aria-hidden="true" data-overscroll data-note={t(lang).overscroll}></div>

<script>
  const note = document.querySelector<HTMLElement>('[data-overscroll]');
  const footer = document.querySelector<HTMLElement>('footer.footer');
  if (note && footer) {
    footer.appendChild(note); // lives inside the footer, right under its last row
    const MAX = 80; // px the footer can stretch
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const atBottom = () => window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    let base = 0; // the footer's own bottom padding
    let stretch = 0;
    let found = false;

    const setStretch = (px: number, animate = false) => {
      stretch = Math.max(0, Math.min(MAX, px));
      if (!base) base = parseFloat(getComputedStyle(footer).paddingBottom) || 0;
      footer.style.transition = animate && !reduce.matches ? 'padding-bottom 320ms cubic-bezier(0.2, 1.4, 0.4, 1)' : '';
      footer.style.paddingBottom = stretch ? `${base + stretch}px` : '';
      // while stretched, the footer comes above the recruiter card that sits at the bottom of phones (z-index 50),
      // so the line isn't hidden under it; back to normal when it springs back
      footer.style.zIndex = stretch ? '60' : '';
      // under the signature and switches, whatever their height on this screen
      // (measured against the footer itself: the row sits inside a container, so offsetTop would be off)
      const rows = footer.querySelector<HTMLElement>('.footer-bottom');
      if (rows) note.style.top = `${Math.round(rows.getBoundingClientRect().bottom - footer.getBoundingClientRect().top + 34)}px`;
      note.style.opacity = String(Math.min(1, stretch / 45) * 0.75);
      if (stretch) window.scrollTo(0, document.documentElement.scrollHeight); // keep the stretched end in view
      if (stretch > 40 && !found) {
        found = true;
        document.dispatchEvent(new CustomEvent('achieve', { detail: 'bottom-note' })); // src/scripts/achievements.ts
      }
    };
    const release = () => {
      if (!stretch) return;
      setStretch(0, true);
      window.setTimeout(() => (footer.style.transition = ''), 400);
    };

    // phones: a finger that keeps dragging up once the page is at its end (with some resistance)
    let startY: number | null = null;
    document.addEventListener(
      'touchstart',
      (e) => {
        startY = e.touches.length === 1 ? e.touches[0].clientY : null;
      },
      { passive: true },
    );
    document.addEventListener(
      'touchmove',
      (e) => {
        if (startY === null) return;
        if (!atBottom() && !stretch) {
          startY = e.touches[0].clientY; // count the pull from where the page reached its end
          return;
        }
        setStretch((startY - e.touches[0].clientY) * 0.45);
      },
      { passive: true },
    );
    document.addEventListener('touchend', () => {
      startY = null;
      release();
    });
    document.addEventListener('touchcancel', () => {
      startY = null;
      release();
    });

    // computers: wheel or trackpad that keeps scrolling down at the end
    let wheelRelease: number | undefined;
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.deltaY <= 0 || (!atBottom() && !stretch)) return;
        setStretch(stretch + e.deltaY * 0.12);
        window.clearTimeout(wheelRelease);
        wheelRelease = window.setTimeout(release, 220);
      },
      { passive: true },
    );
  } else note?.remove();
</script>

<style>
  /* inside the footer, under its last row: invisible until the footer is stretched */
  .overscroll-note {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-text-inverse); /* the footer's light text, on its blue glow */
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  /* the words come from the attribute: drawn, not written in the page (no copying, no finding, no reading aloud) */
  .overscroll-note::after {
    content: attr(data-note);
    content: attr(data-note) / '';
  }
</style>
