---
// Easter egg: pull the page up past its end and a faint line shows under the signature ("Nothing to see here,
// mate."). It is plain text in the empty space at the bottom of the footer, invisible until you keep pulling at the
// very end of the page: a finger dragging up on a phone (iPhone or Android), or a trackpad / wheel that keeps going
// down on a computer. It fades away a moment after you let go.
// The words live in a data attribute and are drawn by CSS (::after), so they can't be selected, copied or found with
// the browser's search, and screen readers skip them (decorative).
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="overscroll-note" aria-hidden="true" data-overscroll data-note={t(lang).overscroll}></div>

<script>
  const note = document.querySelector<HTMLElement>('[data-overscroll]');
  if (note) {
    const atBottom = () => window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 2;
    let hideTimer: number | undefined;
    // just under the signature and the footer's switches (above the recruiter card that sits at the bottom of phones)
    const place = () => {
      const lows = Array.from(document.querySelectorAll('footer .sign, footer .switch-pair'), (el) => el.getBoundingClientRect().bottom);
      const below = lows.length ? Math.max(...lows) + 14 : window.innerHeight - 48;
      note.style.top = `${Math.round(Math.min(below, window.innerHeight - 40))}px`;
    };
    const show = () => {
      window.clearTimeout(hideTimer);
      if (!note.classList.contains('is-pulled')) place();
      note.classList.add('is-pulled');
    };
    const hideSoon = (ms = 1200) => {
      window.clearTimeout(hideTimer);
      hideTimer = window.setTimeout(() => note.classList.remove('is-pulled'), ms);
    };

    // phones: a finger that keeps dragging up once the page is already at its end
    let startY: number | null = null;
    document.addEventListener(
      'touchstart',
      (e) => {
        startY = e.touches.length === 1 ? e.touches[0].clientY : null;
      },
      { passive: true },
    );
    document.addEventListener(
      'touchmove',
      (e) => {
        if (startY === null || !atBottom()) return;
        if (startY - e.touches[0].clientY > 70) show();
      },
      { passive: true },
    );
    document.addEventListener(
      'touchend',
      () => {
        startY = null;
        if (note.classList.contains('is-pulled')) hideSoon();
      },
      { passive: true },
    );

    // computers: wheel or trackpad that keeps scrolling down at the end (a good push, not a single notch)
    let pushed = 0;
    let pushReset: number | undefined;
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.deltaY <= 0 || !atBottom()) {
          pushed = 0;
          return;
        }
        pushed += e.deltaY;
        window.clearTimeout(pushReset);
        pushReset = window.setTimeout(() => (pushed = 0), 500);
        if (pushed > 300) {
          show();
          hideSoon();
        }
      },
      { passive: true },
    );
  }
</script>

<style>
  /* in the empty space under the footer's signature, only while pulling past the end of the page */
  .overscroll-note {
    position: fixed;
    left: 0;
    right: 0;
    top: calc(100% - 56px); /* replaced when it appears: right under the signature */
    z-index: 5;
    margin: 0;
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.875rem;
    color: var(--color-text-inverse); /* the footer's light text, on its blue glow */
    pointer-events: none;
    -webkit-user-select: none;
    user-select: none;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 300ms ease,
      transform 300ms ease;
  }

  /* the words come from the attribute: drawn, not written in the page (no copying, no finding, no reading aloud) */
  .overscroll-note::after {
    content: attr(data-note);
    content: attr(data-note) / '';
  }

  .overscroll-note.is-pulled {
    opacity: 0.7;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .overscroll-note {
      transform: none;
    }
  }
</style>
