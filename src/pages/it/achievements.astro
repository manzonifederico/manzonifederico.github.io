---
// The full achievements board (the same list as the 🏆 window in the footer). Not in search engines.
// Top bar like the project pages: back to the home page on the left, theme and language switches on the right.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Achievements from '../../components/Achievements.astro';
import Footer from '../../components/Footer.astro';
import ThemeSwitch from '../../components/ThemeSwitch.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import HomeButton from '../../components/HomeButton.astro';
---

<BaseLayout lang="it" title="Trofei | Federico Manzoni" noindex>
  <main id="main" class="container">
    <div class="ach-top">
      <HomeButton lang="it" />
      <div class="ach-controls">
        <ThemeSwitch lang="it" />
        <LangSwitch lang="it" />
      </div>
    </div>
    <Achievements lang="it" mode="page" />
  </main>
  <Footer lang="it" />
</BaseLayout>

<style>
  .ach-top {
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: inherit;
  }


  /* the theme button and the EN / IT switch, in the link colour */
  .ach-controls {
    --lang-ink: var(--color-link);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  main {
    position: relative;
  }
</style>
