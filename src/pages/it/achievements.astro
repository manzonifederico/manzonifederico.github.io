---
// The full achievements board (the same list as the 🏆 window in the footer). Not in search engines.
// Top bar like the project pages: back to the home page on the left, theme and language switches on the right.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Achievements from '../../components/Achievements.astro';
import Footer from '../../components/Footer.astro';
import ThemeSwitch from '../../components/ThemeSwitch.astro';
import LangSwitch from '../../components/LangSwitch.astro';
import { localePath } from '../../i18n/ui';
---

<BaseLayout lang="it" title="Achievement | Federico Manzoni" noindex>
  <main id="main" class="container">
    <div class="ach-top">
      <a class="ach-back" href={localePath('it', '/')} data-cursor="Vai alla home">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M4 21V9l8-6l8 6v12h-6v-7h-4v7z" />
        </svg>
        <span class="visually-hidden">Home</span>
      </a>
      <div class="ach-controls">
        <ThemeSwitch lang="it" />
        <LangSwitch lang="it" />
      </div>
    </div>
    <Achievements lang="it" mode="page" />
  </main>
  <Footer lang="it" />
</BaseLayout>

<style>
  .ach-top {
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: inherit;
  }

  /* round button with a house, like the other round controls */
  .ach-back {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--color-fill);
    color: var(--color-on-fill);
    box-shadow: inset 0 0 0 1px var(--color-fill-line);
    transition: transform var(--dur) var(--ease);
  }

  .ach-back:hover {
    transform: scale(1.06);
  }

  /* the theme button and the EN / IT switch, in the link colour */
  .ach-controls {
    --lang-ink: var(--color-link);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  main {
    position: relative;
  }
</style>
