---
import { inlineSvg } from '../../utils/svg';
import { Image } from 'astro:assets';
import SunfestLayout from '../../layouts/SunfestLayout.astro';
import { acts, days, type Stage } from '../../data/sunfest25';
import sunSmall from '../../assets/sunfest25/sun-small.svg?raw';
import map from '../../assets/sunfest25/img/festival-map.jpg';

// Timetable grid: one row per half hour from 16:00 to 02:30 (after midnight counts as 24:00+)
const START = 16 * 60;
const toMin = (t: string) => {
  const [h, m] = t.split(':').map(Number);
  return (h < 12 ? h + 24 : h) * 60 + m;
};
const slot = (t: string) => (toMin(t) - START) / 30 + 1; // 1-based grid line
const times = Array.from({ length: 22 }, (_, i) => {
  const m = START + i * 30;
  const h = Math.floor(m / 60) % 24;
  return `${String(h).padStart(2, '0')}:${String(m % 60).padStart(2, '0')}`;
});
const stages: Stage[] = ['Sun Stage', 'Forest Stage'];
const schedule = days.map((d) => ({
  ...d,
  stages: stages.map((stage) => ({
    stage,
    list: acts
      .filter((a) => a.day === d.n && a.stage === stage)
      .map((a) => {
        const [from, to] = a.time.split('–');
        return { ...a, from, to, row: `${slot(from)} / ${slot(to)}` };
      }),
  })),
}));
---

<SunfestLayout title="Program" page="program" bg="#102542" next={['location', 'lineup', 'faqs']}>
  <h1 class="sf-title">Program</h1>

  <div class="days" role="group" aria-label="Choose a day">
    {
      days.map((d, i) => (
        <button type="button" class="day-btn" data-day={d.n} aria-pressed={i === 0 ? 'true' : 'false'}>
          {d.label}
        </button>
      ))
    }
  </div>

  {
    schedule.map((d) => (
      <section class="sf-wrap program" data-day-panel={d.n} aria-labelledby={`program-day-${d.n}`}>
        <h2 id={`program-day-${d.n}`} class="sf-visually-hidden">
          Day {d.n}, {d.long}
        </h2>
        <p class="hours">{d.open}</p>
        <div class="timeline">
          {d.stages.map((s, si) => (
            <section class:list={['stage', si === 0 ? 'stage--sun' : 'stage--forest']} aria-label={s.stage}>
              <h3 class="stage__name">{s.stage}</h3>
              <ol class="stage__list">
                {s.list.map((a) => (
                  <li class="set" style={`grid-row: ${a.row}`}>
                    {a.thumb ? (
                      <Image class="set__img" src={a.thumb} alt="" width={96} height={96} />
                    ) : (
                      <span class="set__img set__img--none" set:html={inlineSvg(sunSmall)} aria-hidden="true" />
                    )}
                    <span class="set__text">
                      <strong class="set__name">{a.name}</strong>
                      <span class="set__time">
                        <span class="sf-visually-hidden">from </span>
                        {a.from}
                        <span aria-hidden="true">–</span>
                        <span class="sf-visually-hidden"> to </span>
                        {a.to}
                      </span>
                    </span>
                  </li>
                ))}
              </ol>
            </section>
          ))}
          <ol class="clock" aria-hidden="true">
            {times.map((t, i) => (
              <li style={`grid-row: ${i + 1}`}>{t}</li>
            ))}
          </ol>
        </div>
        <p class="hours">{d.close}</p>
      </section>
    ))
  }

  <section class="sf-wrap sf-section map" aria-labelledby="map-title">
    <h2 id="map-title" class="sf-h3">Festival map</h2>
    <Image
      class="sf-photo"
      src={map}
      alt="Illustrated map of the festival in the woods of Rovereto: Sun Stage, Forest Lounge, Woods Stage, DIY craft stalls, food and drink, and the camping area."
      widths={[600, 1000, 1536]}
      sizes="(max-width: 1200px) 92vw, 1000px"
    />
  </section>
</SunfestLayout>

<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('.day-btn')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-day-panel]')];
  const showDay = (n: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.day === n)));
    panels.forEach((p) => (p.hidden = p.dataset.dayPanel !== n));
  };
  buttons.forEach((b) => b.addEventListener('click', () => showDay(b.dataset.day!)));
  showDay('1');
</script>

<style>
  .days {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-bottom: clamp(1.5rem, 4vw, 2.5rem);
    padding-inline: var(--sf-gutter);
  }
  .day-btn {
    min-height: 2.6rem;
    padding: 0.3rem 1.1rem;
    border: 0;
    border-radius: 999px;
    background: #fff;
    color: #000;
    font: 600 1.05rem var(--sf-text);
    cursor: pointer;
  }
  .day-btn[aria-pressed='true'] {
    background: var(--sf-yellow);
  }
  .day-btn:hover {
    box-shadow: 0 3px 0 var(--sf-yellow);
  }

  .program {
    max-width: 920px;
  }
  .hours {
    text-align: center;
    text-decoration: underline;
    text-underline-offset: 3px;
    margin: 1rem auto 1.5rem !important;
  }

  .timeline {
    --row: 4.4rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4rem minmax(0, 1fr);
    grid-template-rows: auto repeat(22, var(--row));
    column-gap: clamp(0.5rem, 2vw, 1.5rem);
  }
  .stage,
  .clock {
    grid-row: 1 / -1;
    display: grid;
    grid-template-rows: subgrid;
  }
  .stage--sun {
    grid-column: 1;
  }
  .stage--forest {
    grid-column: 3;
  }
  .stage__name {
    grid-row: 1;
    margin: 0 0 1rem !important;
    font-size: clamp(1rem, 0.8rem + 0.9vw, 1.6rem);
    text-transform: uppercase;
  }
  .stage--forest .stage__name {
    text-align: right;
  }
  .stage__list {
    grid-row: 2 / -1;
    display: grid;
    grid-template-rows: subgrid;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .clock {
    grid-column: 2;
    list-style: none;
    margin: 0;
    padding: 0;
    grid-row: 2 / -1;
    font-size: 0.9rem;
    text-align: center;
    opacity: 0.85;
  }
  .clock li {
    transform: translateY(-0.7em);
  }

  .set {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin: 0.25rem 0;
    padding: 0.5rem 0.75rem;
    background: #fff;
    color: #102542;
    border-radius: 8px;
    min-width: 0;
    overflow: hidden;
  }
  .set__img {
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 6px;
    object-fit: cover;
  }
  .set__img--none {
    display: grid;
    place-items: center;
    background: #43baff;
    padding: 0.5rem;
  }
  .set__img--none :global(svg) {
    width: 60%;
    height: auto;
  }
  .set__text {
    display: grid;
    min-width: 0;
  }
  .set__name {
    font-size: clamp(0.95rem, 0.8rem + 0.7vw, 1.4rem);
    line-height: 1.1;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }
  .set__time {
    font-size: 0.95rem;
  }

  @media (max-width: 640px) {
    .timeline {
      --row: 4.6rem;
      grid-template-columns: minmax(0, 1fr) 2.9rem minmax(0, 1fr);
      column-gap: 0.4rem;
    }
    .set {
      padding: 0.4rem 0.5rem;
    }
    .set__img {
      display: none;
    }
    .set__name {
      font-size: 0.85rem;
    }
    .set__time {
      font-size: 0.8rem;
    }
    .clock {
      font-size: 0.75rem;
    }
  }

  .map {
    max-width: 1000px;
    text-align: center;
  }
</style>
