---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { t } from '../i18n/ui';
const s = t('en');
---

<BaseLayout title="Page not found | Federico Manzoni" alternates={false} noindex>
  <main id="main" class="container nf">
    <h1 class="title">{s.notFoundTitle}</h1>
    <p>{s.notFoundText} <span lang="it">({t('it').notFoundText})</span></p>
    <p><a href="/">{s.goHome}</a></p>
    <p><a href="/it/" lang="it">{t('it').goHome}</a></p>
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .nf {
    padding-top: 120px;
    display: grid;
    gap: 16px;
  }
  .nf a {
    color: var(--color-link);
  }
</style>
