---
// The full achievements board (the same list as the 🏆 window in the footer). Not in search engines.
import BaseLayout from '../layouts/BaseLayout.astro';
import Achievements from '../components/Achievements.astro';
import Footer from '../components/Footer.astro';
import { localePath } from '../i18n/ui';
---

<BaseLayout lang="en" title="Achievements | Federico Manzoni" noindex>
  <main id="main" class="container">
    <p class="ach-back"><a href={localePath('en', '/')}>← Home</a></p>
    <Achievements lang="en" mode="page" />
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .ach-back {
    position: absolute;
    top: 40px;
  }
  .ach-back a {
    color: var(--color-link);
  }
</style>
