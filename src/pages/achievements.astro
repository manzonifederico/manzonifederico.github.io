---
// The full achievements board (the same list as the 🏆 window in the footer). Not in search engines.
// Top bar like the project pages: back to the home page on the left, theme and language switches on the right.
import BaseLayout from '../layouts/BaseLayout.astro';
import Achievements from '../components/Achievements.astro';
import Footer from '../components/Footer.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import LangSwitch from '../components/LangSwitch.astro';
import { localePath } from '../i18n/ui';
---

<BaseLayout lang="en" title="Achievements | Federico Manzoni" noindex>
  <main id="main" class="container">
    <div class="ach-top">
      <a class="ach-back" href={localePath('en', '/')} data-cursor="Go to home page">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
          <path fill="currentColor" d="M6 19h3.5v-6h5v6H18v-9l-6-4.5L6 10zm-2 2V9l8-6l8 6v12h-7.5v-6h-1v6z" />
        </svg>
        <span class="visually-hidden">Home</span>
      </a>
      <div class="ach-controls">
        <ThemeSwitch lang="en" />
        <LangSwitch lang="en" />
      </div>
    </div>
    <Achievements lang="en" mode="page" />
  </main>
  <Footer lang="en" />
</BaseLayout>

<style>
  .ach-top {
    position: absolute;
    top: 32px;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: inherit;
  }

  /* round button with an outlined house, styled like the project filter chips: blue outline, light fill on hover */
  .ach-back {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-brand-ink);
    border-radius: 50%;
    background: var(--color-surface);
    color: var(--color-brand-ink);
    transition: background var(--dur) var(--ease);
  }

  .ach-back:hover,
  .ach-back:focus-visible {
    background: var(--color-brand-soft);
  }

  /* the theme button and the EN / IT switch, in the link colour */
  .ach-controls {
    --lang-ink: var(--color-link);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  main {
    position: relative;
  }
</style>
